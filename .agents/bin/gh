#!/usr/bin/env python3
"""Serialize every gh invocation on one repository-owned state file, hold a minimum inter-call gap, honor Retry-After once for read-only secondary-limit 403s, and defer instead of issuing a call this identity's rate-limit balance says is already doomed."""

from __future__ import annotations

import base64
import fcntl
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path


PACE_STATE = ".noodle/gh-pace.state"
BUDGET_STATE = ".noodle/gh-budget.json"
ETAG_CACHE = ".noodle/gh-etag"
DEFAULT_MIN_INTERVAL = 1.0
MAX_RETRY_AFTER_SECONDS = 120.0
DEFAULT_QUOTA_FLOOR = 25
QUOTA_RESET_MARGIN_SECONDS = 60.0
# constraint: ed3c/noodles#291 - EX_TEMPFAIL, so a depleted bucket leaves the shared exit as a
# constraint: recoverable wait carrying its own reset instant instead of a system-hard failure.
QUOTA_WAIT_EXIT = 75
QUOTA_WAIT_PREFIX = "NOODLES_GH_QUOTA_WAIT"
READ_ONLY_VERBS = frozenset({"checks", "diff", "list", "status", "view"})
API_WRITE_PREFIXES = ("-f", "-F", "--field", "--raw-field", "--input")
API_WRITE_TARGET = "graphql"
READ_ONLY_METHODS = frozenset({"GET", "HEAD"})
HTTP_403 = re.compile(r"\b403\b")
RETRY_AFTER = re.compile(r"retry-after\s*[:=]?\s*(\d+)", re.IGNORECASE)
# constraint: header lines only. The anchors refuse a JSON body field of the same name, so a
# constraint: response that merely mentions the budget can never be read as the budget itself.
RATE_REMAINING = re.compile(r"(?im)^[ \t]*x-ratelimit-remaining[ \t]*:[ \t]*(\d+)[ \t]*\r?$")
RATE_RESET = re.compile(r"(?im)^[ \t]*x-ratelimit-reset[ \t]*:[ \t]*(\d+)[ \t]*\r?$")
# constraint: ed3c/noodles#292 - an If-None-Match hit returns 304 and costs zero core quota, so the
# constraint: cache only ever needs the ETag the response stated and the exact bytes it came with.
ETAG_HEADER = re.compile(r"(?im)^[ \t]*etag[ \t]*:[ \t]*(\S+)[ \t]*\r?$")
STATUS_LINE = re.compile(r"(?im)^HTTP/[0-9.]+[ \t]+(\d{3})\b")
INCLUDE_FLAGS = frozenset({"--include", "-i"})


def fail(message: str) -> None:
    raise SystemExit(f"NOODLES_GH_WRAPPER_FAIL: {message}")


def repo_root() -> Path:
    return Path(__file__).resolve().parents[2]


def real_gh(self_path: Path) -> str:
    override = os.environ.get("NOODLES_GH_REAL_BIN", "").strip()
    if override:
        return override
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        candidate = Path(entry or ".") / "gh"
        try:
            resolved = candidate.resolve()
        except OSError:
            continue
        if resolved == self_path:
            continue
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    fail("cannot resolve real gh binary")


def option_values(argv: list[str], short: str, long: str) -> list[str]:
    values: list[str] = []
    index = 0
    while index < len(argv):
        argument = argv[index]
        if argument == "--":
            break
        if argument in {short, long}:
            if index + 1 < len(argv):
                values.append(argv[index + 1])
            index += 2
            continue
        if argument.startswith(f"{long}="):
            values.append(argument.split("=", 1)[1])
        elif argument.startswith(short) and len(argument) > len(short):
            values.append(argument[len(short):].removeprefix("="))
        index += 1
    return values


def is_read_only(argv: list[str]) -> bool:
    # constraint: unknown shapes classify as mutations, so an auto-retry can never duplicate a write.
    if not argv:
        return False
    if argv[0] == "api":
        rest = argv[1:]
        if API_WRITE_TARGET in rest or any(argument.startswith(API_WRITE_PREFIXES) for argument in rest):
            return False
        return all(method.upper() in READ_ONLY_METHODS for method in option_values(rest, "-X", "--method"))
    return len(argv) > 1 and argv[1] in READ_ONLY_VERBS


def retry_after_delay(argv: list[str], result: subprocess.CompletedProcess[bytes]) -> float:
    if result.returncode == 0 or not is_read_only(argv):
        return 0.0
    text = (result.stdout + result.stderr).decode("utf-8", "replace")
    if not HTTP_403.search(text):
        return 0.0
    match = RETRY_AFTER.search(text)
    if not match:
        return 0.0
    return min(float(match.group(1)), MAX_RETRY_AFTER_SECONDS)


def token_identity() -> str:
    """Which bucket a recorded balance belongs to, without ever writing the credential down."""
    token = (os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN") or "").strip()
    return hashlib.sha256(token.encode("utf-8")).hexdigest()[:16] if token else "anon"


def budget_state_path(root: Path) -> Path:
    return Path(os.environ.get("NOODLES_GH_BUDGET_STATE") or (root / BUDGET_STATE))


def quota_floor() -> int:
    raw = os.environ.get("NOODLES_GH_QUOTA_FLOOR")
    if raw is None or not raw.strip():
        return DEFAULT_QUOTA_FLOOR
    try:
        return max(0, int(raw))
    except ValueError:
        fail("NOODLES_GH_QUOTA_FLOOR must be an integer count of remaining core calls")


def read_budget(path: Path) -> dict[str, object]:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return payload if isinstance(payload, dict) else {}


def write_budget(path: Path, remaining: int, reset: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    record = {"identity": token_identity(), "remaining": remaining, "reset": reset, "observed_at": int(time.time())}
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(json.dumps(record, sort_keys=True) + "\n", encoding="utf-8")
    temporary.replace(path)


def observed_budget(text: str) -> tuple[int, int] | None:
    """The rate-limit balance this proxied response stated in its own headers, or nothing."""
    remaining = RATE_REMAINING.search(text)
    reset = RATE_RESET.search(text)
    if remaining is None or reset is None:
        return None
    return int(remaining.group(1)), int(reset.group(1))


def quota_wait_seconds(remaining: int, reset: float, now: float) -> float:
    # constraint: a bucket at or below the floor cannot serve the next call, so the honest answer is
    # constraint: the distance to its own reset, never zero and never a hard failure.
    if remaining > quota_floor():
        return 0.0
    wait = reset - now + QUOTA_RESET_MARGIN_SECONDS
    return wait if wait > 0 else 0.0


def recorded_wait(budget: dict[str, object], now: float) -> tuple[float, int, float]:
    """Seconds this identity must wait before its next call, with the balance that decided it."""
    if budget.get("identity") != token_identity():
        # constraint: a balance observed under another credential says nothing about this one; an
        # constraint: unknown bucket is issued, never guessed.
        return 0.0, -1, 0.0
    try:
        remaining = int(budget["remaining"])
        reset = float(budget["reset"])
    except (KeyError, TypeError, ValueError):
        return 0.0, -1, 0.0
    return quota_wait_seconds(remaining, reset, now), remaining, reset


def quota_diagnostic(argv: list[str], remaining: int, reset: float, wait: float, deferred: bool) -> str:
    instant = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(reset))
    verb = "deferred before issuing" if deferred else "recoverable-wait after a quota 403"
    return (
        f"{QUOTA_WAIT_PREFIX}: gh {shlex.join(argv)} {verb}; core remaining={remaining} "
        f"floor={quota_floor()}; recoverable-wait {int(wait)}s until {instant}"
    )


def conditional_key(argv: list[str]) -> str | None:
    """The (token-identity, URL) this invocation may be cached under, or nothing.

    ed3c/noodles#292 - only a read-only `gh api` that already asked for its own headers qualifies:
    the ETag lives in those headers, and replaying a 304 has to reproduce the exact byte shape the
    caller asked for. Every mutation and every shape this cannot reproduce is refused here."""
    if not argv or argv[0] != "api" or not is_read_only(argv):
        return None
    if not INCLUDE_FLAGS & set(argv[1:]):
        return None
    payload = "\n".join([token_identity(), *argv])
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def etag_cache_path(root: Path, key: str) -> Path:
    base = Path(os.environ.get("NOODLES_GH_ETAG_CACHE") or (root / ETAG_CACHE))
    return base / f"{key}.json"


def read_cached(path: Path) -> dict[str, object]:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return payload if isinstance(payload, dict) and payload.get("etag") and payload.get("stdout") else {}


def write_cached(path: Path, etag: str, stdout: bytes) -> None:
    # ponytail: one entry per (identity, URL) with no eviction - the URL set a cycle reads is small
    # ponytail: and bounded; add an age sweep only if .noodle/gh-etag measurably grows.
    path.parent.mkdir(parents=True, exist_ok=True)
    record = {"etag": etag, "stdout": base64.b64encode(stdout).decode("ascii")}
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(json.dumps(record, sort_keys=True) + "\n", encoding="utf-8")
    temporary.replace(path)


def spends_core_budget(argv: list[str]) -> bool:
    """Whether this invocation's rate-limit headers describe the core bucket at all.

    ed3c/noodles#292 - a GraphQL response states the GraphQL point budget in the same header names.
    Recording it as core would let a full point budget mask an empty core bucket, which is exactly
    the blindness ed3c/noodles#291 exists to remove."""
    return not (argv and argv[0] == "api" and API_WRITE_TARGET in argv[1:])


def response_status(text: str) -> int | None:
    match = STATUS_LINE.search(text)
    return int(match.group(1)) if match else None


def pace(root: Path) -> None:
    try:
        interval = float(os.environ.get("NOODLES_GH_MIN_INTERVAL") or DEFAULT_MIN_INTERVAL)
    except ValueError:
        fail("NOODLES_GH_MIN_INTERVAL must be a number of seconds")
    state = Path(os.environ.get("NOODLES_GH_PACE_STATE") or (root / PACE_STATE))
    state.parent.mkdir(parents=True, exist_ok=True)
    # ponytail: one process-wide gap for every gh caller; per-endpoint budgets only if one chatty caller starves another.
    with state.open("a+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        handle.seek(0)
        try:
            previous = float(handle.read().strip() or 0.0)
        except ValueError:
            previous = 0.0
        wait = previous + interval - time.time()
        if wait > 0:
            time.sleep(wait)
        handle.seek(0)
        handle.truncate()
        handle.write(f"{time.time():.6f}\n")
        handle.flush()


def emit(result: subprocess.CompletedProcess[bytes]) -> None:
    sys.stdout.buffer.write(result.stdout)
    sys.stdout.buffer.flush()
    sys.stderr.buffer.write(result.stderr)
    sys.stderr.buffer.flush()


def main() -> int:
    argv = sys.argv[1:]
    root = repo_root()
    state = budget_state_path(root)
    wait, remaining, reset = recorded_wait(read_budget(state), time.time())
    if wait > 0:
        # constraint: ed3c/noodles#291 - the only place that can see the balance is the exit every
        # constraint: caller already crosses; issuing here would spend a call that cannot succeed.
        print(quota_diagnostic(argv, remaining, reset, wait, deferred=True), file=sys.stderr)
        return QUOTA_WAIT_EXIT
    binary = real_gh(Path(__file__).resolve())
    key = conditional_key(argv)
    cached = read_cached(etag_cache_path(root, key)) if key else {}
    # constraint: ed3c/noodles#292 - the conditional header is additive; the caller's own argv is
    # constraint: never rewritten, so a cache miss is byte-identical to the unconditional call.
    attempt = [*argv, "-H", f"If-None-Match: {cached['etag']}"] if cached else list(argv)
    retried = False
    while True:
        pace(root)
        # ponytail: output is buffered so a retried attempt cannot emit twice; interactive gh loses its TTY output shape - call the real binary for that.
        result = subprocess.run([binary, *attempt], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
        combined = (result.stdout + result.stderr).decode("utf-8", "replace")
        observed = observed_budget(combined) if spends_core_budget(argv) else None
        if observed is not None:
            write_budget(state, *observed)
        if key and cached and response_status(combined) == 304:
            # constraint: the upstream said "unchanged" and charged nothing for saying it; the caller
            # constraint: gets the bytes it would have been charged for, and knows they are cached.
            sys.stdout.buffer.write(base64.b64decode(str(cached["stdout"])))
            sys.stdout.buffer.flush()
            print(f"NOODLES_GH_NOT_MODIFIED: {cached['etag']}", file=sys.stderr)
            return 0
        if key and result.returncode == 0:
            etag = ETAG_HEADER.search(result.stdout.decode("utf-8", "replace"))
            if etag is not None:
                write_cached(etag_cache_path(root, key), etag.group(1), result.stdout)
        if retried:
            break
        if result.returncode != 0 and observed is not None and HTTP_403.search(combined):
            quota_wait = quota_wait_seconds(observed[0], float(observed[1]), time.time())
            if quota_wait > 0:
                # constraint: a quota 403 is a wait, not a defect: it is never retried here and never
                # constraint: handed up as a system-hard failure. Its own reset instant is the backoff.
                emit(result)
                print(quota_diagnostic(argv, observed[0], float(observed[1]), quota_wait, deferred=False), file=sys.stderr)
                return QUOTA_WAIT_EXIT
        delay = retry_after_delay(argv, result)
        if delay <= 0:
            break
        retried = True
        time.sleep(delay)
    emit(result)
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
