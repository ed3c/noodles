#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! python3 -c 'import sys, tomllib; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
  echo "FAIL: preflight missing capability: Python 3.11+ runtime with tomllib" >&2
  exit 1
fi
exec python3 "$ROOT/noodles.py" "$@"
