{
  "schema_version": 1,
  "max_tracked_files": 38,
  "max_root_surfaces": 9,
  "max_file_lines": 1000,
  "max_markdown_share": 0.58,
  "min_normalized_entropy": 0.48,
  "min_test_to_executable_ratio": 0.2,
  "max_enabled_providers": 2,
  "max_workflows": 2,
  "required_noodle_mode": "supervised",
  "required_codex_task_profiles": {
    "schedule": {
      "model": "gpt-5.6-luna",
      "reasoning_effort": "max"
    },
    "execute": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high"
    }
  },
  "max_agent_document_hops": 3,
  "agent_document_route": [
    "AGENTS.md",
    "contracts/system-v1.md",
    "issue-named executable contract/test"
  ],
  "required_paths": [
    ".agents/bin/codex",
    ".agents/skills/execute/SKILL.md",
    ".agents/skills/schedule/SKILL.md",
    ".github/workflows/land.yml",
    ".github/workflows/verify.yml",
    ".noodle.toml",
    ".noodle/adapters/github",
    "AGENTS.md",
    "README.md",
    "codex_isolation.py",
    "contracts/system-v1.md",
    "feature_contract.py",
    "migrations/skills-shared/ledger.json",
    "noodles",
    "noodles.py",
    "policy/fitness.json",
    "policy/github.json",
    "policy/providers.lock.json",
    "policy/runtime.lock.json",
    "runtime_contract.py",
    "tests/run.sh",
    "tests/test_noodles.py"
  ],
  "required_executables": [
    ".agents/bin/codex",
    "noodles",
    "noodles.py",
    ".noodle/adapters/github",
    "tests/run.sh"
  ],
  "forbidden_path_names": [
    "__pycache__",
    ".pytest_cache",
    "node_modules",
    "dist",
    "build",
    "receipts",
    "runtime",
    "providers"
  ],
  "forbidden_dependency_manifests": [
    "requirements.txt",
    "pyproject.toml",
    "Pipfile",
    "package.json",
    "go.mod",
    "Cargo.toml"
  ],
  "required_agent_phrases": [
    "NO PROSE MIGRATION",
    "P \u2014 probabilistic guidance",
    "L \u2014 local deterministic gate",
    "R \u2014 provider-enforced readback",
    "N \u2014 non-claim",
    "Human Verifier is not an operational state"
  ],
  "trusted_verify_workflow_phrases": [
    "pull_request_target:",
    "persist-credentials: false",
    "permissions:",
    "contents: read",
    "python3 .trusted/noodles.py github verify-pr"
  ],
  "candidate_self_test_job_phrases": [
    "permissions:",
    "contents: read",
    "runs-on: ubuntu-latest",
    "working-directory: .candidate",
    "run: tests/run.sh"
  ],
  "candidate_self_test_job_forbidden_phrases": [
    ": write"
  ],
  "trusted_verification_job_phrases": [
    "needs: candidate-self-tests",
    "runs-on: ubuntu-latest",
    "python3 -m unittest discover -s .trusted/tests -v",
    "python3 .trusted/noodles.py github verify-pr"
  ],
  "trusted_verification_job_forbidden_phrases": [
    "working-directory: .candidate",
    ".candidate/",
    "tests/run.sh"
  ],
  "trusted_land_workflow_phrases": [
    "workflow_run:",
    "workflows: [verify]",
    "contents: write",
    "pull-requests: write",
    "issues: write",
    "actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1",
    "permission-administration: read",
    "NOODLES_GITHUB_PROTECTION_TOKEN: ${{ steps.app-token.outputs.token }}",
    "python3 noodles.py github land"
  ]
}
